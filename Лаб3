
class Product:
    def __init__(self, name, price, quantity):
        self.name, self.price, self.quantity = name, price, quantity


class Shop:
    def __init__(self):
        self.products = [
            Product("Ноутбук", 25000, 5),
            Product("Смартфон", 12000, 10),
            Product("Навушники", 1500, 15),
            Product("Мишка", 800, 20),
            Product("Клавіатура", 1800, 12)
        ]
        self.cart = []
        self.format_price = lambda p: f"{p:.2f} грн"

    def show_catalog(self):
        for i, p in enumerate(self.products, 1):
            print(f"{i}. {p.name} | {self.format_price(p.price)} | {p.quantity} шт.")

    def add_to_cart(self):
        self.show_catalog()
        try:
            p = self.products[int(input("Номер товару: ")) - 1]
            if p.quantity > 0:
                self.cart.append(p)
                p.quantity -= 1
                print("Товар додано!")
            else:
                print("Немає в наявності!")
        except (ValueError, IndexError):
            print("Неправильний номер!")

    def show_cart(self):
        for i, p in enumerate(self.cart, 1):
            print(f"{i}. {p.name} — {self.format_price(p.price)}")
        print("Сума:", self.format_price(sum(p.price for p in self.cart)))

    def remove_from_cart(self):
        self.show_cart()
        try:
            p = self.cart.pop(int(input("Номер товару: ")) - 1)
            p.quantity += 1
            print("Товар видалено!")
        except (ValueError, IndexError):
            print("Неправильний номер!")

    def buy(self):
        if not self.cart:
            print("Кошик порожній!")
            return
        self.show_cart()
        print("Покупку оформлено!")
        self.cart.clear()

    def admin(self):
        if input("Пароль: ") == "admin123":
            for p in self.products:
                print(p.name, p.quantity, "шт.", self.format_price(p.price))
        else:
            print("Неправильний пароль!")


def main():
    shop = Shop()
    actions = {
        "1": shop.show_catalog,
        "2": shop.add_to_cart,
        "3": shop.show_cart,
        "4": shop.remove_from_cart,
        "5": shop.buy,
        "6": shop.admin
    }

    while True:
        print("\n1. Каталог\n2. Додати\n3. Кошик\n4. Видалити\n5. Купити\n6. Адмін\n0. Вихід")
        choice = input("Ваш вибір: ")

        if choice == "0":
            break
        elif choice in actions:
            actions[choice]()
        else:
            print("Невірний вибір!")


main()
